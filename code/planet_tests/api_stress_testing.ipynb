   "source": [
    "filtered_json = geojson_io_df.to_geo_dict()[\"features\"]\n",
    "\n",
    "# reformat the coordinates list\n",
    "for i in range(len(filtered_json)):\n",
    "    filtered_json[i][\"geometry\"][\"coordinates\"] = [[list(coord) for coord in list(filtered_json[i][\"geometry\"][\"coordinates\"][0])]]\n",
    "\n",
    "# init geojson structure for master list\n",
    "    geojson = {\n",
    "        \"type\": \"MultiPolygon\", \n",
    "        \"coordinates\": []\n",
    "    }\n",
    "\n",
    "for poly in filtered_json:\n",
    "    geojson[\"coordinates\"].append(poly[\"geometry\"][\"coordinates\"])\n",
    "\n",
    "print(f\"shape is valid = {shape(geojson).is_valid}\")\n",
    "shape(geojson)"
   ]
